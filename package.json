{
	"name": "@hyperapi/driver-node",
	"version": "0.7.0-dev",
	"description": "HyperAPI HTTP driver for Node.js.",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"main": "dist/main.mjs",
	"files": [
		"dist/"
	],
	"exports": {
		".": {
			"types": {
				"import": "./dist/main.d.mts",
				"require": "./dist/main.d.cts"
			},
			"import": "./dist/main.mjs",
			"require": "./dist/main.cjs"
		}
	},
	"engines": {
		"node": ">=21"
	},
	"dependencies": {
		"busboy": "1.6.0"
	},
	"peerDependencies": {
		"@hyperapi/core": "github:hyperapi/core#7e59428a9a8954d81467ec4f2eaf7ce32a52daea",
		"@kirick/ip": "^0.2.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.4",
		"@kirick/lint": "0.4.2",
		"@types/busboy": "1.5.4",
		"@types/node": "24.12.3",
		"eslint": "10.7.0",
		"oxlint": "1.74.0",
		"publint": "0.3.21",
		"tsdown": "0.22.3",
		"typescript": "6.0.3",
		"unplugin-unused": "0.5.7",
		"valibot": "1.5.0",
		"vitest": "5.0.5"
	},
	"_devpack": {
		"@hyperapi/core": "../core"
	},
	"scripts": {
		"build": "tsdown src/main.ts --clean --dts --format esm --format cjs --unused --publint",
		"check": "lint && bun run test && bun run build",
		"test": "npm run test:vitest",
		"test:vitest": "tsc -p tsconfig.test.json --noEmit false --outDir node_modules/.vitest-build && vitest run --dir node_modules/.vitest-build --no-file-parallelism"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hyperapi/driver-http-node.git"
	},
	"keywords": [
		"hyperapi",
		"api",
		"driver",
		"hyperapi-driver",
		"http",
		"node",
		"nodejs"
	],
	"author": "Daniil Kirichenko (https://twitter.com/kirickme)",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/hyperapi/driver-http-node/issues"
	},
	"homepage": "https://github.com/hyperapi/driver-http-node#readme"
}
